DATABASE_URL=./data/kairo.db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
ENCRYPTION_KEY=replace-with-a-random-32-byte-hex-key
GOOGLE_OAUTH_CLIENT_FILE=./client_secret.json
# Or set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET directly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Optional AI duration estimates for tasks without a duration. Off unless a key is set;
# task titles, descriptions, and project names are sent to the provider.
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
